<div data-section-id="{{ section.id }}" data-section-type="section-testimonial-countdown" style="{% if section.settings.margin_top != blank %}margin-top: {{section.settings.margin_top}}px;{%endif%} {% if section.settings.margin_bottom != blank %}margin-bottom: {{section.settings.margin_bottom}}px;{% endif %}">
  <div class="section-testimonial-countdown mt-all">
    <div class="container container-v2">
      <div class="row">
        <div class="col-12 col-lg-6">
          <div class="testimonial-content" style="background: {{ section.settings.bg_testimonial }}">
            {% if section.settings.section_title != blank %}
              <div class="text-center">
                <h3 class="title_heading" style="color:{{section.settings.color_title}}">
                  {{section.settings.section_title}}
                </h3>
              </div>
            {% endif %}
            <div class="row js-testimonial-countdown">
              {% if section.blocks.size > 0 %}
              {% for block in section.blocks %}
              {% if block.type == "testimonial" %}
              <div class="col-12">
                <div class="testimonial-inner">
                  <div class="avatar">
                    {% if block.settings.block_img != blank %}
                    <img width="88" height="88" src="{{block.settings.block_img|img_url:'master'}}" class="img-fluid" alt="testimonial">
                    {% else %}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                  </div>
                  <div class="testimonial-info">
                    <p class="text" style="color: {{block.settings.color_content}}">{{block.settings.block_content}}</p> 
                    <span class="engoc-star star-5"></span>
                  </div>
                  <div class="testimonial-author">
                    <div class="author-info">
                      <h3 class="mb-1" style="color: {{block.settings.color_name}}">{{block.settings.block_name}}</h3>
                      <p class="text-position" style="color: {{block.settings.color_des}}">{{block.settings.block_des}}</p>
                    </div>
                  </div>
                </div>
              </div>
              {% endif %}
              {% endfor %}
              {% endif %}
            </div>
          </div>
        </div>
        <div class="col-12 col-lg-6">
          <div class="countdown-content">
            <div class="text-center relative">        	
              {% if section.settings.title_info != blank %}
              <div class="title-info text-center">
                <h2 class="title_heading" style="color: {{section.settings.color_title_info}}">{{section.settings.title_info}}</h2>
              </div>
              {% endif %}
            </div>
            <div class="countdown-item">
              {% for block in section.blocks %}
              {% if block.type == "countdown" %}
              <div class="product product-grid product-item">
                {% if block.settings.select_pd != blank %}
                {% assign product = all_products[block.settings.select_pd] %}
                <div class="row">
                  <div class="col-12 col-sm-6 col-xl-5 pd-image">
                    <a href="{{ product.url | within: collection }}" title="">
                      <img src="{{ product.featured_image.src | img_url: 'large' }}" alt="{{ product.featured_image.alt | escape }}">
                      {% for image in product.images %}     
                      {% if forloop.last == true %}
                      <img src="{{ image.src | product_img_url: 'large' }}" alt="{{ product.featured_image.alt | escape }}">   
                      {%endif%}
                      {% endfor %}
                    </a>
                  </div>
                  <div class="col-12 col-sm-6 col-xl-7 cd-info">
                    {% if block.settings.enable_label_pd %}
                    {% if product.compare_at_price != blank %}
                    {% assign sale = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                    <label>-{{sale}}%</label>
                    {% endif %}
                    {% endif %}
                    <h4 class="pd-name mb-0"><a href="{{product.url}}">{{product.title}}</a></h4>
                    <div class="product-price">
                      <span class="amout">
                        <del class="sale-price">{{ product.compare_at_price | money }}</del>
                        {% capture price %}{{ product.price | money }}{% endcapture %}
                        <span >{{ price }}</span>
                      </span>
      
                    </div>
                    {% if block.settings.timer != blank %}
                    <ul class="timer" data-countdown="testimonial-countdown" data-date="{{block.settings.timer}}"></ul>
                    {% endif %}
                    {% if block.settings.btn_name != blank %}
                    <div class="">
                      <a class="button-main3" href="{{product.url}}">{{block.settings.btn_name}}</a>
                    </div>
                    {%  endif %}
                  </div>
                </div>
                {% else %}
                <div class="row">
                  <div class="col-12 col-sm-6 col-xl-5 pd-image">
                    <a href="/admin/products"> 
                      {% capture current_1 %}{% cycle 1, 2, 3 %}{% endcapture %}
                      {{ 'product-' | append: current_1 | placeholder_svg_tag: 'placeholder-svg' }}
                    </a>
                    
                  </div>
                  <div class="col-12 col-sm-6 col-xl-7 cd-info">
                    <h4 class="pd-name mb-0"><a href="/admin/products">Example Product</a></h4>
                    <div class="product-price">
                      <span class="amout">
                        <span >$40.00</span>
                      </span>
      
                    </div>
                    {% if block.settings.timer != blank %}
                    <ul class="timer" data-countdown="testimonial-countdown" data-date="{{block.settings.timer}}"></ul>
                    {% endif %}
                    {% if block.settings.btn_name != blank %}
                    <div class="">
                      <a class="button-main3" href="{{product.url}}">{{block.settings.btn_name}}</a>
                    </div>
                    {%  endif %}
                  </div>
                </div>
                {% endif %}
              </div>
              {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TESTIMONIAL V2",
  "class": "index-section",
  "settings": [
