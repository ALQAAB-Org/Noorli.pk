          "default": "#fff"
        },
        {
          "type": "text",
          "id": "block_name",
          "label": "Content",
          "default": "DESTINEE"
        },
        {
          "type": "color",
          "id": "color_name",
          "label": "Color Name"
        },
        {
          "type": "text",
          "id": "block_des",
          "label": "Info",
          "default": "Marketing Personal"
        },
        {
          "type": "color",
          "id": "color_des",
          "label": "Color Des"
        }
      ]
    },
    {
      "type": "countdown",
	  "limit": 2,
      "name": "Countdown",
      "settings": [
        {
          "type": "header",
          "content": "Countdown Item"
        },
        {
          "type": "product",
          "id": "select_pd",
          "label": "Select Product"
        },
        {
          "type": "checkbox",
          "id": "enable_label_pd",
          "label": "Enable Label",
          "default": true
        },
        {
          "type": "text",
          "id": "timer",
          "label": "End date",
          "default": "2023-12-12-12-12-12",
          "info": "format datetime YYYY-MM-DD-hh-mm-ss"
        },
