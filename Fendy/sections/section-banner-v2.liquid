      "id": "url_banner2",
      "label": "URL Banner 2",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Settings Color"
    },
    {
      "type": "color",
      "id": "color_title_vertical",
      "label": "Color Title Vertical",
      "default": "#000"
    },
    {
      "type": "color",
      "id": "color_title",
