<div data-section-id="{{ section.id }}" data-section-type="section-banner-v2" style="{% if section.settings.margin_top != blank %}margin-top: {{section.settings.margin_top}}px;{%endif%} {% if section.settings.margin_bottom != blank %}margin-bottom: {{section.settings.margin_bottom}}px;{% endif %}">
  <div class="section-banner-v2 {% if section.settings.ena_margin_top %} mt-all {% endif %}">
    <div class="container container-v2">
      <div class="row"> 
        <div class="col-md-6">
          <div class="banner-left">
            <div class="banner-item">
              <div class="banner-image">
                <div class="box-img">
                  {% if section.settings.img_banner1 != blank %}
                  <a href="{{section.settings.url_banner1}}">
                    <img data-src="{{section.settings.img_banner1 | img_url : 'master'}}" class="lazyload img-fluid w-100" alt="_img_banner">
                  </a>
                  {% else %}
                  <a href="{{section.settings.url_banner1}}">
                    <img data-src="//via.placeholder.com/518x650" class="lazyload img-fluid w-100" alt="_img_banner">
                  </a>
                  {% endif %}
                </div>
                <div class="title-vertical">
                  {% if section.settings.title_vertical1 != blank %}
                  <span style="color: {{section.settings.color_title_vertical}}">{{section.settings.title_vertical1}}</span>
                  {% endif %}
                </div>
              </div>
              <div class="banner-info">
                {% if section.settings.title_banner1 != blank %}
                <h3 class="title-banner" style="color: {{section.settings.color_title_banner}}">{{section.settings.title_banner1}}</h3>
                {% endif %}
                <div class="more-info">
                  {% if section.settings.content1 != blank %}
                  <span style="color: {{section.settings.color_content}}">{{section.settings.content1}}</span>
                  {% endif %}
                  {% if section.settings.btn_banner1 != blank %}
                  <a href="{{section.settings.url_banner1}}" class="button-main3 btn-banner-{{ section.id }}">
                    {{section.settings.btn_banner1}}
                  </a>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="banner-right">
            <div class="banner-item">
              <div class="row no-gutters">
                <div class="col-12 order-md-1 order-2">
                  <div class="banner-info">
                    {% if section.settings.title_banner2 != blank %}
                    <h3 class="title-banner" style="color: {{section.settings.color_title_banner}}">{{section.settings.title_banner2}}</h3>
                    {% endif %}
                    <div class="more-info">
                      {% if section.settings.content2 != blank %}
                      <span style="color: {{section.settings.color_content}}">{{section.settings.content2}}</span>
                      {% endif %}
                      {% if section.settings.btn_banner2 != blank %}
                      <a href="{{section.settings.url_banner2}}" class="button-main3 btn-banner-{{ section.id }}">
                        {{section.settings.btn_banner2}}
                      </a>
                      {% endif %}
                    </div>
                  </div>
                </div>
                <div class="col-12 order-md-2 order-1">
                  <div class="banner-image">
                    <div class="box-img">
                      {% if section.settings.img_banner2 != blank %}
                      <a href="{{section.settings.url_banner2}}">
                        <img data-src="{{section.settings.img_banner2 | img_url : 'master'}}" class="lazyload img-fluid w-100" alt="_img_banner">
                      </a>
                      {% else %}
                      <a href="{{section.settings.url_banner2}}">
                        <img data-src="//via.placeholder.com/628x775" class="lazyload img-fluid w-100" alt="_img_banner">
                      </a>
                      {% endif %}
                    </div>
                    <div class="title-vertical">
                      {% if section.settings.title_vertical2 != blank %}
                      <span style="color: {{section.settings.color_title_vertical}}">{{section.settings.title_vertical2}}</span>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .section-banner-v2 .banner-item .banner-info .more-info .btn-banner-{{ section.id }}:before{
    border-color: {{block.settings.color_block_button}} !important;
  }
  .section-banner-v2 .banner-item .banner-info .more-info .btn-banner-{{ section.id }}}:hover {
    color: {{block.settings.color_block_button_hover}} !important;
  }
  .section-banner-v2 .banner-item .banner-info .more-info .btn-banner-{{ section.id }}:hover:before{
    border-color: {{block.settings.color_block_button_hover}} !important;
  }
</style>
