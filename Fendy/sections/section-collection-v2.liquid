<div data-section-id="{{ section.id }}" data-section-type="section-collection-v2" style="{% if section.settings.margin_top != blank %}margin-top: {{section.settings.margin_top}}px;{%endif%} {% if section.settings.margin_bottom != blank %}margin-bottom: {{section.settings.margin_bottom}}px;{% endif %} {% if section.settings.sections_layout == "dark" %}background: {{section.settings.sections_bg_color}};{% endif %}">
  <div class="section-collection-v2 mt-all">
    <div class="container container-v2">
      <div class="text-center">

        {% if section.settings.title_heading != blank %}
        <h3 class="title_heading mb-0" style="color: {{section.settings.color_title}}">{{section.settings.title_heading}}</h3>
        {% endif %}

      </div>
      <div class="row js-collection-v2">
        {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
        {% if block.type == 'colection' %}
        <div class="col-12 col-item">
          <div class="item text-center">
            <div class="box-img">
              <a href="{{block.settings.brand_url}}" class="">
                {% if block.settings.brand_img != blank %}
                <img data-src="{{block.settings.brand_img | img_url:'master'}}" class="lazyload img-fluid w-100" alt="_img_collection">
                {% else %}
                <img data-src="//via.placeholder.com/256x256" class="lazyload img-fluid w-100" alt="_img_collection">
                {% endif %}
                <span class="category-img-hover">
                  {% if block.settings.brand_img2 != blank %}
                  <img data-src="{{block.settings.brand_img2 | img_url:'master'}}" class="lazyload img-fluid w-100" alt="_img_collection">
                  {% else %}
                  <img data-src="//via.placeholder.com/258x258" class="lazyload img-fluid w-100" alt="_img_collection">
                  {% endif %}
                </span>
              </a>

            </div>
            <div class="category-info">
              <div class="box-info">
                {% if block.settings.title_collection != blank %}
                  <h3 class="title-collection">
                    <a style="color: {{block.settings.color_title}}" href="{{block.settings.brand_url}}" class="">
                      {{block.settings.title_collection}}
                    </a>
                  </h3>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
        {% endif %}
        {% endfor %}
        {% endif %} 
      </div>
    </div>
  </div>
</div>

<style>
</style>

{% schema %}
{
  "name": "COLLECTION V2",
  "class": "index-section",
  "settings": [
    {
      "type": "text",
      "id": "title_heading",
      "label": "Title Heading",
      "default": "Our Collection"
    },
    {
      "type": "color",
      "id": "color_title",
      "label": "Color",
      "default": "#000"
    },
    {
      "type": "header",
      "content": "Section Space"
    },
    {
      "type": "text",
      "id": "margin_top",
      "label": "Margin Top",
      "info": "Defined in pixels. Do not add the 'px' unit."
    },
    {
      "type": "text",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "info": "Defined in pixels. Do not add the 'px' unit."
    }
  ],
  "blocks": [
    {
      "type": "colection",
      "name": "Item Collection",
      "settings": [
        {
          "type": "image_picker",
          "id": "brand_img",
          "info": "256 x 256px recommended",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "brand_img2",
          "info": "256 x 256px recommended",
          "label": "Image 2"
        },
        {
          "type": "text",
          "id": "title_collection",
          "label": "Title Collection",
          "default": "Jade Plant"
        },
        {
          "type": "color",
          "id": "color_title",
          "label": "Color Title",
          "default": "#000"
        },
        {
          "type": "url",
          "id": "brand_url",
          "label": "URL collection",
          "default": "/collections/all"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "COLLECTION V2",
      "category": "HOME",
      "blocks": [
        {
          "type": "colection",
          "settings": {
            "title_collection": "Jade Plant"
          }
        },
        {
          "type": "colection",
          "settings": {
            "title_collection": "Alovera Plant"
          }
        },
        {
          "type": "colection",
          "settings": {
            "title_collection": "Orchid Plant"
          }
        },
        {
          "type": "colection",
          "settings": {
            "title_collection": "Cactus Plant"
          }
        },
        {
          "type": "colection",
          "settings": {
            "title_collection": "Peace Lily"
          }
        }
      ]
    }
  ]
}
{% endschema %}


{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
